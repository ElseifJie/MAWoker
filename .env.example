# ===== 运行环境 =====
# 运行模式：development | production | test
NODE_ENV=development

# ===== 数据库 =====
# PostgreSQL 连接字符串（格式：postgres://用户:密码@主机:端口/数据库名）
# 密码中的特殊字符（如 @）需按 URL 编码转义，例如 @ 写作 %40
DATABASE_URL=postgres://user:password@localhost:5432/personal_work_agent

# ===== 应用 =====
# 前端应用源地址（用于 CORS 配置，开发环境默认 Vite 端口）
APP_ORIGIN=http://localhost:5173
# API 服务监听端口
PORT=3000

# ===== OIDC 认证 =====
# 预留给未来接入托管身份服务；当前登录不依赖它，账号由管理员创建
OIDC_ISSUER=https://identity.example.com
# OIDC 客户端 ID
OIDC_CLIENT_ID=dev-client-id
# OIDC 客户端密钥
OIDC_CLIENT_SECRET=your-oidc-client-secret

# ===== 管理员种子账号（由 npm 脚本读取，不属于运行时配置）=====
# 在 .env 中配置下面三项，然后执行 `npm run admin:seed` 创建或修复管理员账号；
# `npm run data:reset` 也会用到同样的配置。
# 管理员邮箱（必须为合法邮箱；其他账号由管理员登录后在后台创建）
#   ADMIN_EMAIL=admin@example.com
# 管理员密码（至少 8 位；只保存 scrypt 哈希，无法找回，只能重置）
#   ADMIN_PASSWORD=change-me-please
# 设为 1 时，每次执行 admin:seed 都用上面的密码覆盖管理员密码；
# 改密码只需改这里的值再跑一次 `npm run admin:seed`。
#   ADMIN_RESET=1

# ===== 火山引擎方舟 API =====
# 方舟 API 基础地址（只填 origin，不要带 /api/v3 —— 接口路径由客户端拼接）
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com
# 方舟 API Key（仅保存在服务端，不暴露给前端）
ARK_API_KEY=
# 方舟环境 ID（Managed Agent 运行环境标识）
ARK_ENVIRONMENT_ID=
# 方舟 API 请求超时时间（毫秒）
ARK_REQUEST_TIMEOUT_MS=15000
# 方舟 API 最大重试次数
ARK_MAX_ATTEMPTS=3
# 重试基础延迟（毫秒，指数退避起点）
ARK_RETRY_BASE_DELAY_MS=100
# 重试最大延迟（毫秒，指数退避上限）
ARK_RETRY_MAX_DELAY_MS=2000

# ===== System Agents（管理员页面只读）=====
# 已存在的方舟 Agent ID，多个值用逗号分隔
# 名称、描述、模型和版本会在 API 启动时通过 Agent ID 从方舟查询
# Agent 使用的模型必须在 MODEL_ALLOWLIST 中
# 修改后重启 API 自动同步；移出的 Agent 停用，保留历史引用，不删除方舟资源
# 首次配置前执行 npm run admin:seed；本配置不创建或修改方舟 Agent
# 示例：SYSTEM_AGENT_IDS=agent-research,agent-code
SYSTEM_AGENT_IDS=

# ===== TOS 对象存储 =====
# TOS 服务端点地址
TOS_ENDPOINT=https://tos-s3-cn-beijing.volces.com
# TOS 存储桶名称（3-63 位小写字母、数字或短横线）
TOS_BUCKET=
# TOS 区域
TOS_REGION=cn-beijing
# TOS 访问密钥 ID
TOS_ACCESS_KEY_ID=your-tos-access-key-id
# TOS 访问密钥 Secret
TOS_SECRET_ACCESS_KEY=your-tos-secret-access-key
# TOS 临时会话令牌（可选；使用 STS 临时凭证时替换为真实令牌，用长期 AK/SK 时请整行删除，留空会校验失败）
TOS_SESSION_TOKEN=your-tos-session-token

# ===== 模型与网络白名单 =====
# 允许使用的模型白名单（逗号分隔，必须非空；不在列表中的模型会被拒绝）
MODEL_ALLOWLIST=deepseek-v4-pro-ga-260813,deepseek-v4-1-flash-260910
# 出站主机白名单（逗号分隔）。应用只校验该值的格式（必须为非空主机名，
# 不接受 IP 字面量），并不在运行时自行拦截出站请求；真实的工具执行网络
# 限制由 Ark Environment 侧带外配置，此处用于声明应放行哪些主机并与之保持一致。
OUTBOUND_HOST_ALLOWLIST=ark.cn-beijing.volces.com,tos-s3-cn-beijing.volces.com

# ===== 云盘对象生命周期 =====
# 失去引用的对象（例如所属 Session 被删除后）在 TOS 中保留多久再回收，
# 单位毫秒；0 表示一旦失去引用就立即回收（一期语义：删除 Session 即删除其产物）。
# 若将来要让产物在 Session 删除后仍留在用户云盘，把它调大即可，无需改架构。
DRIVE_ORPHAN_RETENTION_MS=0

# ===== 配额与用量限制 =====
# 运行时配额以数据库 quota_policies 表的 'default' 行为准；以下四项由
# `npm run admin:seed` 与 `npm run data:reset` 写入该行时读取
# （须为非负整数，0 表示不允许；前两项缺省时分别为 10 和 2，后两项必填）
# 每位用户最多可创建的个人 Agent 数量
PERSONAL_AGENT_LIMIT=10
# 每位用户最大并发 Session 数
CONCURRENT_SESSION_LIMIT=2
# 每位用户每日创建 Session 上限
SESSION_DAILY_LIMIT=25
# 每位用户每月 Token 消耗上限
MONTHLY_TOKEN_LIMIT=1000000

# ===== API 速率限制 =====
# 全局 API 速率限制最大值（每个时间窗口内允许的请求数）
API_RATE_LIMIT_MAX=120
# 速率限制时间窗口（毫秒）
API_RATE_LIMIT_WINDOW_MS=60000

# ===== 健康检查 =====
# 数据库健康检查超时时间（毫秒）
HEALTH_DB_TIMEOUT_MS=1000

# ===== Worker 后台任务 =====
# Worker 健康检查监听地址
WORKER_HEALTH_HOST=0.0.0.0
# Worker 健康检查监听端口
WORKER_HEALTH_PORT=3001
# Worker 后台任务轮询间隔（毫秒）
WORKER_POLL_INTERVAL_MS=1000

# ===== 阶段 A 事件恢复与成果交付 =====
# 关闭开关只暂停对应后台能力，保留已持久化记录
SESSION_SUBMISSION_ADMISSION_ENABLED=true
FILE_REUSE_ADMISSION_ENABLED=true
SESSION_HISTORY_ENABLED=true
SESSION_DELIVERY_ENABLED=true
SESSION_HISTORY_BATCH_SIZE=2
SESSION_HISTORY_COOLDOWN_MS=60000
SESSION_HISTORY_TIMEOUT_MS=30000
SESSION_DELIVERY_BATCH_SIZE=2
SESSION_DELIVERY_TIMEOUT_MS=30000
# 事件归集：默认关闭；影子模式只写本地日志并记录游标，SSE 仍读上游
SESSION_EVENT_INGESTOR_ENABLED=false
SESSION_EVENT_INGESTOR_LEASE_MS=30000
SESSION_EVENT_INGESTOR_BUDGET_MS=5000
SESSION_EVENT_INGESTOR_BATCH_SIZE=2
# 迟到成果最多对账 5 分钟；无文件回合等待 30 秒后可完成
SESSION_ARTIFACT_RETRY_WINDOW_MS=300000
SESSION_ARTIFACT_EMPTY_GRACE_MS=30000

# ===== 个人 Memory Store =====
# 可选应用总正文预算（字节）；为空时不显示总量百分比
MEMORY_BYTE_BUDGET=
# Dream 模型需在 MODEL_ALLOWLIST 内；留空禁用自动 Dream，仍可确定性压缩
MEMORY_DREAM_MODEL=
MEMORY_MONITOR_INTERVAL_MS=300000
MEMORY_COOLDOWN_MS=21600000
