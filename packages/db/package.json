{
  "name": "@pwa/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@pwa/auth": "0.1.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  }
}
