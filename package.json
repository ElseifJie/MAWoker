{
  "name": "personal-work-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -ws --if-present",
    "dev": "concurrently -n api,web,worker \"npm run dev -w @pwa/api\" \"npm run dev -w @pwa/web\" \"npm run dev -w @pwa/worker\"",
    "dev:api": "npm run dev -w @pwa/api",
    "dev:web": "npm run dev -w @pwa/web",
    "dev:worker": "npm run dev -w @pwa/worker",
    "db:generate": "npm run db:generate -w @pwa/db",
    "db:check": "npm run db:check -w @pwa/db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:acceptance": "vitest run apps/web/src/Task18.acceptance.test.tsx",
    "test:acceptance:full": "vitest run apps/web/src/Task18.acceptance.test.tsx tests/task-18-isolation.integration.test.ts tests/task-18-recovery.acceptance.test.ts",
    "test:e2e": "playwright test",
    "test:postgres": "vitest run tests/db-postgres-contention.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.35.0",
    "fastify": "^5.12.3",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
